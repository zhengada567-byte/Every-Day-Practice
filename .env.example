# Copy to .env or env.txt and fill in from your database provider.
# Do not commit .env or env.txt.

# Supabase (recommended): Project Settings → Database → Connection string → URI
# Use Transaction pooler for Netlify; Session/direct (port 5432) for local migrations.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8888
# Required for POST /api/v1/admin/parents (create parent accounts)
ADMIN_API_KEY=change-me-admin-secret

# Kimi (Moonshot AI) — Level 3 sentence checking (server only, never in browser)
MOONSHOT_API_KEY=sk-your-moonshot-key
# Optional: https://api.moonshot.ai/v1 (default) or https://api.moonshot.cn/v1
# MOONSHOT_API_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=moonshot-v1-8k

# Optional — not used by server SQL today (publishable key is NOT DATABASE_URL)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
