# Copy to .env and fill in from Neon dashboard (Connection string → pooled).
# Do not commit .env or env.txt.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8888
# Required for POST /api/v1/admin/parents (create parent accounts)
ADMIN_API_KEY=change-me-admin-secret

# Kimi (Moonshot AI) — Level 3 sentence checking (server only, never in browser)
MOONSHOT_API_KEY=sk-your-moonshot-key
# Optional: https://api.moonshot.ai/v1 (default) or https://api.moonshot.cn/v1
# MOONSHOT_API_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=moonshot-v1-8k
